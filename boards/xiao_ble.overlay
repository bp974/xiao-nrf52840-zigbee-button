#include <zephyr/dt-bindings/gpio/gpio.h>

/ {
    chosen {
        ncs,zigbee-timer = &timer2;
    };

    /* Button 1: XIAO D1 / nRF52840 P0.03, active low to GND. */

    buttons {
        compatible = "gpio-keys";

        button0: button_0 {
            gpios = <&gpio0 3 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
            label = "Button 1";
        };
    };

    aliases {
        sw0 = &button0;
    };
};

&timer2 {
    status = "okay";
};
